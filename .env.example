# Copy to .env for local Windows development. Never commit .env.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=anime_platform
DB_USER=Chengzi
DB_PASSWORD=change_me

# Bootstrap/admin connection used only by database initialization scripts.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=

# Spring Boot
SERVER_PORT=8080
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION_MINUTES=120
APP_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
